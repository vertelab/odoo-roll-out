<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Record rule: project managers see their projects -->
        <record id="rollout_project_manager_rule" model="ir.rule">
            <field name="name">Rollout Project: Manager access</field>
            <field name="model_id" ref="model_rollout_project"/>
            <field name="domain_force">[('project_manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Record rule: team members see their projects -->
        <record id="rollout_project_team_rule" model="ir.rule">
            <field name="name">Rollout Project: Team member access</field>
            <field name="model_id" ref="model_rollout_project"/>
            <field name="domain_force">[('team_member_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
