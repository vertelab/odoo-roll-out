<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_role_tree" model="ir.ui.view">
        <field name="name">rollout.role.tree</field>
        <field name="model">rollout.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="employee_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_role_form" model="ir.ui.view">
        <field name="name">rollout.role.form</field>
        <field name="model">rollout.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Required Skills">
                            <field name="required_skill_ids">
                                <list editable="bottom">
                                    <field name="skill_id"/>
                                    <field name="required_level"/>
                                </list>
                            </field>
                        </page>
                        <page string="Required Courses">
                            <field name="required_course_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Required Badges">
                            <field name="required_badge_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Task Templates">
                            <field name="task_template_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employees">
                            <field name="employee_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Phases">
                            <field name="phase_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
