<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_role_tree" model="ir.ui.view">
        <field name="name">rollout.role.tree</field>
        <field name="model">rollout.role</field>
        <field name="arch" type="xml">
            <list string="Roles">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_role_form" model="ir.ui.view">
        <field name="name">rollout.role.form</field>
        <field name="model">rollout.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Task Templates">
                            <field name="task_template_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="deadline_days"/>
                                    <field name="priority"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rollout_role" model="ir.actions.act_window">
        <field name="name">Rollout Roles</field>
        <field name="res_model">rollout.role</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
