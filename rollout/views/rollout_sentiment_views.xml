<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_sentiment_tree" model="ir.ui.view">
        <field name="name">rollout.sentiment.tree</field>
        <field name="model">rollout.sentiment</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="phase_id"/>
                <field name="score" widget="priority"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_sentiment_form" model="ir.ui.view">
        <field name="name">rollout.sentiment.form</field>
        <field name="model">rollout.sentiment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="project_id"/>
                        <field name="phase_id"/>
                        <field name="user_id"/>
                        <field name="score"/>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
