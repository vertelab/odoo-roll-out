<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_portfolio_tree" model="ir.ui.view">
        <field name="name">rollout.portfolio.tree</field>
        <field name="model">rollout.portfolio</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="active_project_count"/>
                <field name="total_competency_gap"/>
                <field name="total_risk_score"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_portfolio_form" model="ir.ui.view">
        <field name="name">rollout.portfolio.form</field>
        <field name="model">rollout.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="manager_id"/>
                    </group>
                    <group string="Projects">
                        <field name="project_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Metrics">
                        <field name="active_project_count"/>
                        <field name="total_competency_gap"/>
                        <field name="avg_sentiment"/>
                        <field name="total_risk_score"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
