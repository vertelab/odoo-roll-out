<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_nudge_tree" model="ir.ui.view">
        <field name="name">rollout.nudge.tree</field>
        <field name="model">rollout.nudge</field>
        <field name="arch" type="xml">
            <list string="Nudges">
                <field name="name"/>
                <field name="trigger_event"/>
                <field name="nudge_type"/>
                <field name="role_id"/>
                <field name="phase_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_nudge_form" model="ir.ui.view">
        <field name="name">rollout.nudge.form</field>
        <field name="model">rollout.nudge</field>
        <field name="arch" type="xml">
            <form string="Nudge">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="trigger_event"/>
                        <field name="nudge_type"/>
                    </group>
                    <group string="Scope">
                        <field name="phase_id"/>
                        <field name="role_id"/>
                    </group>
                    <group string="Message Template">
                        <field name="template" widget="ace" options="{'mode': 'qweb'}"
                               colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
