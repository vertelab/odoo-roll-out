<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_competency_target_tree" model="ir.ui.view">
        <field name="name">rollout.competency.target.tree</field>
        <field name="model">rollout.competency.target</field>
        <field name="arch" type="xml">
            <list decoration-warning="state=='at_risk'" decoration-success="state=='achieved'"
                  decoration-danger="state=='missed'">
                <field name="name"/>
                <field name="phase_id"/>
                <field name="role_id"/>
                <field name="target_count"/>
                <field name="current_count"/>
                <field name="gap"/>
                <field name="progress_pct" widget="progressbar"/>
                <field name="deadline"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_competency_target_form" model="ir.ui.view">
        <field name="name">rollout.competency.target.form</field>
        <field name="model">rollout.competency.target</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="phase_id"/>
                            <field name="role_id"/>
                        </group>
                        <group>
                            <field name="skill_id"/>
                            <field name="level"/>
                            <field name="target_count"/>
                            <field name="current_count"/>
                            <field name="deadline"/>
                        </group>
                    </group>
                    <group>
                        <field name="gap"/>
                        <field name="progress_pct" widget="progressbar"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
