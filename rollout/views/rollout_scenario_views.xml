<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_scenario_tree" model="ir.ui.view">
        <field name="name">rollout.scenario.tree</field>
        <field name="model">rollout.scenario</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="risk_level"/>
                <field name="adoption_estimate" widget="progressbar"/>
                <field name="cost_estimate"/>
                <field name="selected"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_scenario_form" model="ir.ui.view">
        <field name="name">rollout.scenario.form</field>
        <field name="model">rollout.scenario</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_select" type="object" string="Select as Active"
                            invisible="selected"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="description"/>
                    </group>
                    <group string="Overrides">
                        <field name="override_date_start"/>
                        <field name="override_date_launch"/>
                    </group>
                    <group string="Assessment">
                        <field name="risk_level"/>
                        <field name="adoption_estimate"/>
                        <field name="cost_estimate" widget="monetary"/>
                    </group>
                    <group string="Phase Overrides">
                        <field name="phase_override_ids">
                            <list editable="bottom">
                                <field name="phase_id"/>
                                <field name="override_duration_days"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
