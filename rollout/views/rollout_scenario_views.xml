<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_scenario_tree" model="ir.ui.view">
        <field name="name">rollout.scenario.tree</field>
        <field name="model">rollout.scenario</field>
        <field name="arch" type="xml">
            <list string="Scenarios">
                <field name="name"/>
                <field name="risk_level"/>
                <field name="adoption_estimate"/>
                <field name="cost_estimate"/>
                <field name="selected" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_scenario_form" model="ir.ui.view">
        <field name="name">rollout.scenario.form</field>
        <field name="model">rollout.scenario</field>
        <field name="arch" type="xml">
            <form string="Scenario">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id"/>
                    </group>
                    <group string="Overrides">
                        <field name="override_date_start"/>
                        <field name="override_date_launch"/>
                    </group>
                    <group string="Assessment">
                        <field name="risk_level"/>
                        <field name="adoption_estimate"/>
                        <field name="cost_estimate" widget="monetary"/>
                    </group>
                    <group>
                        <field name="selected"/>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                    </group>
                    <separator string="Phase Adjustments"/>
                    <field name="phase_adjustment_ids">
                        <list editable="bottom">
                            <field name="phase_id"/>
                            <field name="override_duration_days"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rollout_scenario" model="ir.actions.act_window">
        <field name="name">Scenarios</field>
        <field name="res_model">rollout.scenario</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
