<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_org_change_tree" model="ir.ui.view">
        <field name="name">rollout.org.change.tree</field>
        <field name="model">rollout.org.change</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="change_type"/>
                <field name="phase_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_org_change_form" model="ir.ui.view">
        <field name="name">rollout.org.change.form</field>
        <field name="model">rollout.org.change</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="change_type"/>
                        <field name="project_id"/>
                        <field name="phase_id"/>
                        <field name="description"/>
                    </group>
                    <group string="HR Links">
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="job_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
