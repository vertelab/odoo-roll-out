<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Tree -->
    <record id="view_rollout_project_tree" model="ir.ui.view">
        <field name="name">rollout.project.tree</field>
        <field name="model">rollout.project</field>
        <field name="arch" type="xml">
            <list string="Rollout Projects">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="project_manager_id"/>
                <field name="state" widget="badge"/>
                <field name="planning_mode"/>
                <field name="date_start"/>
                <field name="date_launch"/>
                <field name="phase_count"/>
            </list>
        </field>
    </record>

    <!-- Project Kanban -->
    <record id="view_rollout_project_kanban" model="ir.ui.view">
        <field name="name">rollout.project.kanban</field>
        <field name="model">rollout.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="project_manager_id"/>
                <field name="state"/>
                <field name="date_launch"/>
                <field name="phase_count"/>
                <field name="risk_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="oe_kanban_content">
                                <strong><field name="name"/></strong>
                                <div><field name="customer_id"/></div>
                                <div>
                                    <field name="state" widget="badge"/>
                                    <field name="date_launch" widget="remaining_days"
                                           invisible="not date_launch"/>
                                </div>
                                <div class="text-muted">
                                    Phases: <field name="phase_count"/> |
                                    Risks: <field name="risk_count"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Project Form -->
    <record id="view_rollout_project_form" model="ir.ui.view">
        <field name="name">rollout.project.form</field>
        <field name="model">rollout.project</field>
        <field name="arch" type="xml">
            <form string="Rollout Project">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_complete" type="object" string="Complete"
                            invisible="state != 'active'" class="btn-success"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rollout Project Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="project_manager_id"/>
                            <field name="sponsor_id"/>
                        </group>
                        <group>
                            <field name="planning_mode"/>
                            <field name="date_start"
                                   required="planning_mode == 'forward'"/>
                            <field name="date_launch"
                                   required="planning_mode == 'backward'"/>
                        </group>
                    </group>
                    <group string="Project Team">
                        <field name="team_member_ids" widget="many2many_tags"/>
                    </group>

                    <notebook>
                        <page string="Phases">
                            <field name="phase_ids" widget="one2many_list"/>
                        </page>
                        <page string="Risks">
                            <field name="risk_ids"/>
                        </page>
                        <page string="Competency Targets">
                            <field name="competency_target_ids"/>
                        </page>
                        <page string="Org Changes">
                            <field name="org_change_ids"/>
                        </page>
                        <page string="Scenarios">
                            <field name="scenario_ids"/>
                        </page>
                        <page string="Sentiment">
                            <field name="sentiment_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_rollout_project" model="ir.actions.act_window">
        <field name="name">Rollout Projects</field>
        <field name="res_model">rollout.project</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
