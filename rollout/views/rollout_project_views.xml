<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================ -->
    <!-- rollout.project                                                   -->
    <!-- ================================================================ -->
    <record id="view_rollout_project_tree" model="ir.ui.view">
        <field name="name">rollout.project.tree</field>
        <field name="model">rollout.project</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='draft'" decoration-success="state=='active'"
                  decoration-muted="state in ('completed','cancelled','migrated')">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="manager_id"/>
                <field name="state"/>
                <field name="perspective"/>
                <field name="overall_progress" widget="progressbar"/>
                <field name="total_competency_gap"/>
                <field name="total_risk_score"/>
                <field name="date_launch"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_project_form" model="ir.ui.view">
        <field name="name">rollout.project.form</field>
        <field name="model">rollout.project</field>
        <field name="arch" type="xml">
            <form string="Rollout Project">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="state not in ('draft')" class="btn-primary"/>
                    <button name="action_complete" type="object" string="Complete"
                            invisible="state not in ('active')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'active')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Project Name"/>
                        <h1><field name="name" placeholder="e.g. Acme Odoo Implementation"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="manager_id"/>
                            <field name="sponsor_id"/>
                            <field name="team_member_ids" widget="many2many_tags"/>
                        </group>
                        <group name="timeline">
                            <field name="perspective"/>
                            <field name="planning_mode"/>
                            <field name="date_start"
                                   required="planning_mode == 'forward'"/>
                            <field name="date_launch"
                                   required="planning_mode == 'backward'"/>
                        </group>
                    </group>
                    <group string="Migration" invisible="migration_state == 'none'">
                        <field name="migration_state"/>
                        <field name="migrated_from" invisible="migration_state != 'imported'"/>
                        <field name="migrated_at"/>
                    </group>
                    <notebook>
                        <page string="Phases">
                            <field name="phase_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="adkar_phase"/>
                                    <field name="duration_days"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="gate_type"/>
                                    <field name="gate_passed" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Competency Targets">
                            <field name="competency_target_ids"/>
                        </page>
                        <page string="Roles">
                            <field name="role_ids"/>
                        </page>
                        <page string="Risks">
                            <field name="risk_ids"/>
                        </page>
                        <page string="Sentiment">
                            <field name="sentiment_ids">
                                <list editable="bottom">
                                    <field name="create_date"/>
                                    <field name="user_id"/>
                                    <field name="dimension"/>
                                    <field name="wave"/>
                                    <field name="score" widget="priority"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Nudges">
                            <field name="nudge_ids"/>
                        </page>
                        <page string="Org Changes">
                            <field name="org_change_ids"/>
                        </page>
                        <page string="Scenarios">
                            <field name="scenario_ids"/>
                        </page>
                        <page string="Plan Reviews">
                            <field name="plan_review_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_rollout_project_search" model="ir.ui.view">
        <field name="name">rollout.project.search</field>
        <field name="model">rollout.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="manager_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <separator/>
                <filter name="external" string="External" domain="[('perspective','=','external')]"/>
                <filter name="internal" string="Internal" domain="[('perspective','=','internal')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="by_perspective" string="Perspective" domain="[]" context="{'group_by': 'perspective'}"/>
                    <filter name="by_manager" string="Manager" domain="[]" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_rollout_project_kanban" model="ir.ui.view">
        <field name="name">rollout.project.kanban</field>
        <field name="model">rollout.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="manager_id"/>
                <field name="state"/>
                <field name="overall_progress"/>
                <field name="total_competency_gap"/>
                <field name="total_risk_score"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="name"/></strong>
                                <div><field name="customer_id"/></div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="manager_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <span class="oe_kanban_bottom_left">
                                        <field name="state"/>
                                    </span>
                                    <span class="oe_kanban_bottom_right">
                                        Progress: <field name="overall_progress"/>%
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
