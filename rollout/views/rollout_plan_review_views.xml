<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_plan_review_tree" model="ir.ui.view">
        <field name="name">rollout.plan.review.tree</field>
        <field name="model">rollout.plan.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="review_date"/>
                <field name="reviewer_id"/>
                <field name="overall_score"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_plan_review_form" model="ir.ui.view">
        <field name="name">rollout.plan.review.form</field>
        <field name="model">rollout.plan.review</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <group>
                        <field name="project_id"/>
                        <field name="review_date"/>
                        <field name="reviewer_id"/>
                    </group>
                    <field name="criteria_score_ids">
                        <list editable="bottom">
                            <field name="criteria_id"/>
                            <field name="score"/>
                            <field name="justification"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Plan Review Criteria (data) -->
    <record id="view_rollout_plan_review_criteria_tree" model="ir.ui.view">
        <field name="name">rollout.plan.review.criteria.tree</field>
        <field name="model">rollout.plan.review.criteria</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dimension"/>
                <field name="sequence"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_plan_review_criteria_form" model="ir.ui.view">
        <field name="name">rollout.plan.review.criteria.form</field>
        <field name="model">rollout.plan.review.criteria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="dimension"/>
                        <field name="sequence"/>
                        <field name="description"/>
                        <field name="max_score"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
