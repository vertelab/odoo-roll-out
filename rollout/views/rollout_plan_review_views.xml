<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_plan_review_tree" model="ir.ui.view">
        <field name="name">rollout.plan.review.tree</field>
        <field name="model">rollout.plan.review</field>
        <field name="arch" type="xml">
            <list string="Plan Reviews" decoration-success="overall_rating == 'excellent'"
                  decoration-warning="overall_rating == 'weak'"
                  decoration-danger="overall_rating == 'critical'">
                <field name="name"/>
                <field name="reviewer_id"/>
                <field name="review_date"/>
                <field name="overall_score"/>
                <field name="overall_rating" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_plan_review_form" model="ir.ui.view">
        <field name="name">rollout.plan.review.form</field>
        <field name="model">rollout.plan.review</field>
        <field name="arch" type="xml">
            <form string="Plan Review">
                <header>
                    <button name="action_start_review" type="object" string="Start Review"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_complete" type="object" string="Complete"
                            invisible="state != 'in_progress'" class="btn-success"/>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'completed' or approved_by_id == False"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="reviewer_id"/>
                            <field name="review_date"/>
                        </group>
                        <group>
                            <field name="scenario_id"/>
                            <field name="overall_score" widget="gauge"/>
                            <field name="overall_rating"/>
                            <field name="approved_by_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dimensions">
                            <field name="dimension_ids" nolabel="1">
                                <list>
                                    <field name="dimension"/>
                                    <field name="score" widget="gauge"/>
                                    <field name="rating" widget="badge"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="dimension"/>
                                        <field name="score" widget="gauge"/>
                                        <field name="rating"/>
                                    </group>
                                    <notebook>
                                        <page string="Criteria">
                                            <field name="criterion_ids" nolabel="1">
                                                <list editable="bottom">
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="name"/>
                                                    <field name="score"/>
                                                    <field name="action_required"/>
                                                </list>
                                            </field>
                                        </page>
                                        <page string="SWOT">
                                            <group string="Strengths">
                                                <field name="strengths"/>
                                            </group>
                                            <group string="Weaknesses">
                                                <field name="weaknesses"/>
                                            </group>
                                            <group string="Opportunities">
                                                <field name="opportunities"/>
                                            </group>
                                            <group string="Threats">
                                                <field name="threats"/>
                                            </group>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page string="Summary">
                            <group>
                                <field name="summary"/>
                                <field name="recommendations"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rollout_plan_review" model="ir.actions.act_window">
        <field name="name">Plan Reviews</field>
        <field name="res_model">rollout.plan.review</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
