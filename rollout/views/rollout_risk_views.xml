<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_risk_tree" model="ir.ui.view">
        <field name="name">rollout.risk.tree</field>
        <field name="model">rollout.risk</field>
        <field name="arch" type="xml">
            <list decoration-danger="risk_score >= 15" decoration-warning="risk_score >= 8">
                <field name="name"/>
                <field name="probability"/>
                <field name="impact"/>
                <field name="risk_score"/>
                <field name="owner_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_risk_form" model="ir.ui.view">
        <field name="name">rollout.risk.form</field>
        <field name="model">rollout.risk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_monitor" type="object" string="Monitor" invisible="state not in ('identified')"/>
                    <button name="action_materialize" type="object" string="Materialized" invisible="state not in ('monitoring')"/>
                    <button name="action_mitigate" type="object" string="Mitigate" invisible="state not in ('materialized')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="phase_id"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="probability"/>
                            <field name="impact"/>
                            <field name="risk_score"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <group string="Mitigation">
                        <field name="mitigation"/>
                        <field name="trigger_event"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
