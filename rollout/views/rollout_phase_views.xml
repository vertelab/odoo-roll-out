<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_phase_tree" model="ir.ui.view">
        <field name="name">rollout.phase.tree</field>
        <field name="model">rollout.phase</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="adkar_phase"/>
                <field name="duration_days"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="gate_type"/>
                <field name="gate_passed" widget="boolean_toggle"/>
                <field name="progress" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_phase_form" model="ir.ui.view">
        <field name="name">rollout.phase.form</field>
        <field name="model">rollout.phase</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="adkar_phase"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="duration_days"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group string="Gate">
                        <field name="gate_type"/>
                        <field name="gate_metric" invisible="gate_type != 'metric'"/>
                        <field name="gate_passed"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
