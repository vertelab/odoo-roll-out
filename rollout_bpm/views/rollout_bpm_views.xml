<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_project_form_inherit_bpm" model="ir.ui.view">
        <field name="name">rollout.project.form.inherit.bpm</field>
        <field name="model">rollout.project</field>
        <field name="inherit_id" ref="rollout.view_rollout_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="BPM Process" name="bpm_process">
                    <group>
                        <field name="bpm_workflow_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
