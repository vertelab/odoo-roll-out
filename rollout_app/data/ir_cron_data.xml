<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Spawn next period's lines. Sunday evening, so Monday is ready. -->
        <record id="ir_cron_rollout_app_spawn" model="ir.cron">
            <field name="name">Rollout App: spawn period lines</field>
            <field name="model_id" ref="model_rollout_module_line"/>
            <field name="state">code</field>
            <field name="code">model.cron_rollout_app_spawn()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 23:00:00')"/>
        </record>

        <!-- Send pending push nudges. -->
        <record id="ir_cron_rollout_push_dispatch" model="ir.cron">
            <field name="name">Rollout App: dispatch push notifications</field>
            <field name="model_id" ref="model_rollout_push_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_rollout_push_dispatch()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Evaluate 'still_open' reminders for the current period. -->
        <record id="ir_cron_rollout_app_remind" model="ir.cron">
            <field name="name">Rollout App: evaluate reminders</field>
            <field name="model_id" ref="model_rollout_app_line"/>
            <field name="state">code</field>
            <field name="code">model.cron_rollout_app_remind()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 07:00:00')"/>
        </record>
    </data>
</odoo>
