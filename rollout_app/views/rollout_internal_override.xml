<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Point "My Rollout Journey" at the app, keeping the list views as
         a fallback. The action is replaced, not the views, so nothing is
         lost if the app is uninstalled. -->
    <record id="rollout_internal.action_rollout_internal_dashboard"
            model="ir.actions.act_window">
        <field name="name">My Rollout Journey</field>
        <field name="res_model">rollout.app.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to do right now</p>
            <p>Your tasks will appear here when a period is published.</p>
        </field>
    </record>
</odoo>
