<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Apps -->
    <record id="view_rollout_app_tree" model="ir.ui.view">
        <field name="name">rollout.app.list</field>
        <field name="model">rollout.app</field>
        <field name="arch" type="xml">
            <list string="Apps">
                <field name="name"/>
                <field name="project_id"/>
                <field name="module_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rollout_app_form" model="ir.ui.view">
        <field name="name">rollout.app.form</field>
        <field name="model">rollout.app</field>
        <field name="arch" type="xml">
            <form string="App">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Modules">
                        <field name="module_ids" widget="many2many_tags"
                               nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="module_id"/>
                                    <field name="state"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="app_line_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rollout_app" model="ir.actions.act_window">
        <field name="name">Apps</field>
        <field name="res_model">rollout.app</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
