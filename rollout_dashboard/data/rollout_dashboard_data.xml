<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Adoption Overview Dashboard -->
        <record id="dashboard_rollout_adoption" model="dashboard.dashboard">
            <field name="name">Rollout: Adoption Overview</field>
            <field name="key">rollout_adoption</field>
            <field name="category">Rollout</field>
            <field name="description">Overview of rollout adoption: active users, progress, completed tasks, competency targets achieved.</field>
            <field name="icon">fa-chart-line</field>
            <field name="cache_ttl">300</field>
            <field name="auto_reload_duration">300000</field>
        </record>

        <!-- Sentiment Heatmap Dashboard -->
        <record id="dashboard_rollout_sentiment" model="dashboard.dashboard">
            <field name="name">Rollout: Sentiment Analysis</field>
            <field name="key">rollout_sentiment</field>
            <field name="category">Rollout</field>
            <field name="description">Sentiment trends per project, phase, and department. Hotspot detection and free-text analysis.</field>
            <field name="icon">fa-smile-o</field>
            <field name="cache_ttl">300</field>
            <field name="auto_reload_duration">300000</field>
        </record>

        <!-- Risk Radar Dashboard -->
        <record id="dashboard_rollout_risk" model="dashboard.dashboard">
            <field name="name">Rollout: Risk Radar</field>
            <field name="key">rollout_risk</field>
            <field name="category">Rollout</field>
            <field name="description">Risk matrix visualization: probability × impact heatmap per project and phase.</field>
            <field name="icon">fa-exclamation-triangle</field>
            <field name="cache_ttl">300</field>
            <field name="auto_reload_duration">300000</field>
        </record>

        <!-- Readiness Trend Dashboard -->
        <record id="dashboard_rollout_readiness" model="dashboard.dashboard">
            <field name="name">Rollout: Plan Readiness</field>
            <field name="key">rollout_readiness</field>
            <field name="category">Rollout</field>
            <field name="description">Plan readiness score trend over time with dimension breakdown.</field>
            <field name="icon">fa-check-circle</field>
            <field name="cache_ttl">300</field>
            <field name="auto_reload_duration">300000</field>
        </record>

    </data>
</odoo>
