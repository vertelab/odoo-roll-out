<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rollout_project_form_inherit_mgmt" model="ir.ui.view">
        <field name="name">rollout.project.form.inherit.mgmt</field>
        <field name="model">rollout.project</field>
        <field name="inherit_id" ref="rollout.view_rollout_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="ISO / Management System" name="mgmt_system">
                    <group>
                        <field name="mgmtsystem_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_rollout_phase_form_inherit_mgmt" model="ir.ui.view">
        <field name="name">rollout.phase.form.inherit.mgmt</field>
        <field name="model">rollout.phase</field>
        <field name="inherit_id" ref="rollout.view_rollout_phase_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group[@name]" position="after">
                <group string="ISO / Management System">
                    <field name="mgmt_clause_ids" widget="many2many_tags"/>
                    <field name="mgmt_policy_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
